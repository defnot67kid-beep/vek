// Host must register a vek::RuntimePlatformPack first.
fn setup_hud() {
    gui_define({ id:"hud.root", type:"panel", x:20, y:20, width:300, height:120 });
    gui_define({ id:"hud.fps", type:"label", parent:"hud.root", text:"Performance" });
    gameplay_define({ id:"ability.sprint", type:"ability", display_name:"Sprint", cooldown:0.25 });
    return true;
}

fn main() {
    setup_hud();
    let stats = perf_stats();
    let gpu = gpu_info();
    println("FPS", stats.fps, "GPU", gpu.adapter);
    return 0;
}
