    logo_rotation_speed: 0.72,
    logo_pitch_speed: 0.18,
    runner_scroll_speed: 245,
    runner_gravity: 1500,
    runner_jump_velocity: -570,
    update_policy_default: "manual",
    repository: "https://github.com/defnot67kid-beep/vek.git"
};
println("installer experience ready", installer_scene.repository);
