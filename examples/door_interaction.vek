# Door interaction example for VEK 2.6.0
# Click and hold the knob, rotate left, then push to open.

state door = {
  knob_held:false,
  knob_turn:0.0,
  open_ratio:0.0
};

fn on_knob_hold_begin() {
  door.knob_held = true;
}

fn on_knob_hold_end() {
  door.knob_held = false;
}

fn on_knob_drag_left(delta) {
  if (door.knob_held) {
    door.knob_turn = clamp(door.knob_turn + delta, 0.0, 1.0);
  }
}

fn on_door_push(push_delta) {
  if (door.knob_turn >= 0.85) {
    door.open_ratio = clamp(door.open_ratio + push_delta, 0.0, 1.0);
  }
}
