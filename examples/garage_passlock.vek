fn setup() {
    animation_register({
        id: "garage.open",
        duration: 2.5,
        loop: false,
        tags: ["garage"]
    });

    garage_register({
        id: "garage.main",
        width: 20,
        height: 7,
        panel_count: 8,
        starts_locked: true,
        allow_inside_egress: true,
        inside_open_distance: 6.0,
        hold_open_near_door: true,
        open_animation: "garage.open"
    });

    passlock_register({
        id: "garage.access",
        code: "2580",
        garage_id: "garage.main",
        max_use_distance: 4.5,
        requires_line_of_sight: true,
        outside_only: true,
        show_world_prompt: false,
        click_only: true,
        max_attempts: 5,
        lockout_seconds: 10
    });

    gui_define_style("access_text", {
        font_size: 20,
        min_font_size: 11,
        max_font_size: 22,
        max_lines: 2,
        auto_fit: true,
        wrap: true,
        ellipsis: true,
        clip_text: true,
        text_align: "center"
    });

    gui_begin_modal("access", "GARAGE ACCESS", "access_text");
    gui_label("Secure engineering access", "access_text");
    gui_password_input("pin", "****", "access_text");
    gui_status_badge("state", "LOCKED", "warning", "access_text");
    gui_keypad("pad", ["1","2","3","4","5","6","7","8","9","CLEAR","0","ENTER"], "access_text");
    gui_end_modal();
    return true;
}
