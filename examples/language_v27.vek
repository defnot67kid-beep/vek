/* VEK 2.7 language example */
fn average(values) {
    let total = 0;
    for value in values {
        total = total + value;
    }
    if len(values) == 0 { throw "cannot average an empty array"; }
    return total / len(values);
}

fn main() {
    try {
        let value = average([16, 20, 24, 28]);
        println("average =", value);
        return value;
    } catch (error) {
        println("error:", error);
        return 0;
    }
}
