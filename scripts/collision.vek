// ================================================================
// VEK 0.1 - Vehicle Engineering Kernel
// Game collision rules
// ================================================================
// C++ detects geometric contacts. This script decides gameplay response.
// Edit this file and press F11 in-game to hot reload it.

fn on_collision(a, b, speed) {
    // Human avatar against workshop/buildings/world limits.
    if pair(a, b, "player", "world") {
        solid(true);
        friction(0.68);
        bounce(0.0);

        // Architecture is already ready for dangerous moving impacts later.
        if speed > 11.0 {
            damage((speed - 11.0) * 0.5);
        }
    }

    // Walking into your parked vehicle should feel solid but not bouncy.
    if pair(a, b, "player", "vehicle") {
        solid(true);
        friction(0.72);
        bounce(0.0);
    }

    // Vehicle impacts have a little suspension/body rebound and can damage
    // the vehicle at higher impact speeds.
    if pair(a, b, "vehicle", "world") {
        solid(true);
        friction(0.55);
        bounce(0.12);

        if speed > 7.5 {
            let impact = (speed - 7.5) * 1.25;
            damage(clamp(impact, 0.0, 28.0));
        }
    }
}
