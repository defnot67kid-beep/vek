# VEK 1.8 camera, skybox, rig and global gameplay policy.
# Native C++ executes the camera matrices/rendering/physics; VEK owns the safe rules.

fn joint(name, parent, length, radius, mass, weight, pmin, pmax, ymin, ymax, rmin, rmax) {
    return {
        name: name, parent: parent, length: length, radius: radius,
        mass: mass, ragdoll_weight: weight,
        pitch_min: pmin, pitch_max: pmax,
        yaw_min: ymin, yaw_max: ymax,
        roll_min: rmin, roll_max: rmax
    };
}

fn setup_camera_world() {
    camera_profile_register({
        id: "camera.player",
        third_person_distance: 8.0,
        close_distance: 4.3,
        target_height: 1.15,
        close_target_height: 1.35,
        first_person_eye_height: 1.66,
        fov: 60,
        pitch_min: -25,
        pitch_max: 65,
        yaw_sensitivity: 0.12,
        pitch_sensitivity: 0.10,
        max_yaw_speed: 720,
        max_pitch_speed: 540,
        yaw_acceleration: 3200,
        yaw_deceleration: 4200,
        pitch_acceleration: 2600,
        pitch_deceleration: 3400,
        alignment_step: 45,
        rmb_look: true,
        invert_mouse_y: false,
        rmb_yaw_scale: 1.0,
        rmb_pitch_scale: 1.0,
        editor_move_speed: 12,
        editor_fast_multiplier: 3.0,
        editor_fine_multiplier: 0.25,
        editor_yaw_speed: 90,
        editor_pitch_speed: 58.5,
        editor_pitch_min: -85,
        editor_pitch_max: 85,
        editor_fov: 60,
        editor_ortho_size: 28,
        prevent_below_world: true,
        minimum_world_y: 0.35,
        minimum_target_y: 0.05,
        cycle_modes: ["third_person", "close_third_person", "first_person", "free_inspection"]
    });

    skybox_register({
        id: "sky.engineering_day",
        zenith: {r: 83, g: 145, b: 205, a: 255},
        horizon: {r: 175, g: 205, b: 229, a: 255},
        ground: {r: 86, g: 103, b: 89, a: 255},
        sun: {r: 255, g: 235, b: 174, a: 255},
        horizon_height: 0.56,
        sun_yaw: 38,
        sun_pitch: 48,
        sun_size: 24,
        ambient: 0.72,
        fog_start: 140,
        fog_end: 290,
        dynamic_day_night: false,
        day_length_seconds: 1200
    });

    rig_register({
        id: "rig.player_mechanic_v2",
        ragdoll_strength: 1.0,
        spine_flex: 0.92,
        neck_flex: 1.05,
        limb_flex: 1.15,
        joints: [
            joint("root", "", 0.16, 0.14, 8.0, 0.35, -25, 25, -35, 35, -25, 25),
            joint("pelvis", "root", 0.28, 0.15, 8.0, 0.70, -45, 45, -50, 50, -40, 40),
            joint("spine_lower", "pelvis", 0.25, 0.13, 5.5, 0.85, -55, 45, -45, 45, -35, 35),
            joint("spine_upper", "spine_lower", 0.28, 0.14, 5.0, 1.00, -60, 55, -55, 55, -45, 45),
            joint("chest", "spine_upper", 0.24, 0.16, 6.0, 1.00, -55, 55, -55, 55, -45, 45),
            joint("neck", "chest", 0.14, 0.08, 1.2, 1.15, -55, 55, -65, 65, -50, 50),
            joint("head", "neck", 0.28, 0.18, 4.2, 1.10, -60, 60, -75, 75, -55, 55),
            joint("clavicle_l", "chest", 0.18, 0.07, 0.8, 0.95, -60, 70, -70, 70, -60, 60),
            joint("upperarm_l", "clavicle_l", 0.34, 0.10, 2.0, 1.20, -145, 110, -105, 105, -120, 120),
            joint("forearm_l", "upperarm_l", 0.31, 0.08, 1.4, 1.25, -155, 15, -45, 45, -65, 65),
            joint("hand_l", "forearm_l", 0.15, 0.08, 0.7, 1.15, -80, 80, -55, 55, -65, 65),
            joint("clavicle_r", "chest", 0.18, 0.07, 0.8, 0.95, -60, 70, -70, 70, -60, 60),
            joint("upperarm_r", "clavicle_r", 0.34, 0.10, 2.0, 1.20, -145, 110, -105, 105, -120, 120),
            joint("forearm_r", "upperarm_r", 0.31, 0.08, 1.4, 1.25, -155, 15, -45, 45, -65, 65),
            joint("hand_r", "forearm_r", 0.15, 0.08, 0.7, 1.15, -80, 80, -55, 55, -65, 65),
            joint("thigh_l", "pelvis", 0.43, 0.13, 4.0, 1.25, -125, 75, -45, 45, -45, 45),
            joint("shin_l", "thigh_l", 0.42, 0.11, 3.0, 1.35, -5, 145, -20, 20, -20, 20),
            joint("ankle_l", "shin_l", 0.11, 0.08, 0.9, 1.00, -55, 45, -30, 30, -25, 25),
            joint("foot_l", "ankle_l", 0.25, 0.10, 1.0, 0.85, -45, 50, -25, 25, -20, 20),
            joint("thigh_r", "pelvis", 0.43, 0.13, 4.0, 1.25, -125, 75, -45, 45, -45, 45),
            joint("shin_r", "thigh_r", 0.42, 0.11, 3.0, 1.35, -5, 145, -20, 20, -20, 20),
            joint("ankle_r", "shin_r", 0.11, 0.08, 0.9, 1.00, -55, 45, -30, 30, -25, 25),
            joint("foot_r", "ankle_r", 0.25, 0.10, 1.0, 0.85, -45, 50, -25, 25, -20, 20)
        ]
    });

    world_policy_register({
        id: "game.default",
        target_fps: 120,
        walk_speed: 3.3,
        run_speed: 6.0,
        sprint_speed: 9.2,
        interaction_distance: 3.5,
        vehicle_enter_distance: 3.6,
        map_marker_distance: 250,
        physics_max_dt: 0.05,
        camera_rmb_look: true,
        sky_enabled: true
    });
    return true;
}

fn camera_world_ids() {
    return {
        camera: "camera.player",
        skybox: "sky.engineering_day",
        rig: "rig.player_mechanic_v2",
        world_policy: "game.default"
    };
}
