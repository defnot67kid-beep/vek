// VEK 1.1 player gameplay rules.
// C++ owns transforms/collision/rendering. This script owns tunable gravity,
// health, fall-damage and ragdoll policy.

fn character_gravity(velocity, dt, grounded, default_gravity, terminal_speed) {
    if grounded { return 0; }
    return gravity_step(velocity, default_gravity, terminal_speed, dt, false);
}

fn character_jump(grounded, default_jump_speed) {
    return gravity_jump(grounded, default_jump_speed);
}

fn character_damage(current_health, max_health, amount) {
    return health_damage(current_health, max_health, amount);
}

fn character_heal(current_health, max_health, amount) {
    return health_heal(current_health, max_health, amount);
}

fn fall_damage(landing_speed) {
    // Normal jumps are safe. Hard falls progressively damage the humanoid.
    if landing_speed <= 11 { return 0; }
    let damage = (landing_speed - 11) * 4;
    return clamp(damage, 0, 100);
}

fn should_ragdoll(health, impact_speed, damage) {
    return ragdoll_should_trigger(health, impact_speed, damage, 13, 25);
}

fn ragdoll_duration(impact_speed) {
    return ragdoll_duration(impact_speed, 13, 25, 0.8, 3.0);
}

fn ragdoll_direction(horizontal_x, horizontal_z) {
    if abs(horizontal_x) > abs(horizontal_z) {
        if horizontal_x < 0 { return -1; }
        return 1;
    }
    if horizontal_z < 0 { return -1; }
    return 1;
}
