fn setup_hangar_interactions() {
    animation_register({
        id: "hangar.use_passlock",
        duration: 1.15,
        speed: 1.0,
        loop: false,
        blend_in: 0.08,
        blend_out: 0.10,
        markers: [
            { name: "reach", time: 0.16 },
            { name: "tap", time: 0.42 },
            { name: "confirm", time: 0.88 }
        ],
        tags: ["character", "interaction", "passlock", "keypad"]
    });

    animation_register({
        id: "hangar.garage_open",
        duration: 2.65,
        speed: 1.0,
        loop: false,
        markers: [
            { name: "motor_start", time: 0.05 },
            { name: "clear_person", time: 1.45 },
            { name: "fully_open", time: 2.60 }
        ],
        tags: ["world", "garage", "door", "mechanical"]
    });

    animation_register({
        id: "hangar.garage_close",
        duration: 2.35,
        speed: 1.0,
        loop: false,
        markers: [
            { name: "motor_start", time: 0.05 },
            { name: "warning", time: 0.35 },
            { name: "latched", time: 2.30 }
        ],
        tags: ["world", "garage", "door", "mechanical"]
    });

    garage_register({
        id: "hangar.main_garage",
        display_name: "Main Engineering Garage Door",
        width: 24.0,
        height: 8.5,
        panel_count: 9,
        open_duration: 2.65,
        close_duration: 2.35,
        auto_close_delay: 18.0,
        starts_locked: true,
        auto_close: true,
        allow_inside_egress: true,
        inside_open_distance: 7.0,
        hold_open_near_door: true,
        panel_overlap: 0.035,
        side_seal_width: 0.38,
        lintel_height: 0.72,
        collision_clear_fraction: 0.60,
        open_animation: "hangar.garage_open",
        close_animation: "hangar.garage_close",
        access_id: "hangar.builder_access"
    });

    passlock_register({
        id: "hangar.builder_access",
        display_name: "VEK ENGINEERING ACCESS",
        code: "2580",
        garage_id: "hangar.main_garage",
        max_use_distance: 4.5,
        requires_line_of_sight: true,
        outside_only: true,
        show_world_prompt: false,
        click_only: true,
        min_digits: 4,
        max_digits: 6,
        max_attempts: 5,
        lockout_seconds: 10.0,
        allow_keyboard: true,
        allow_mouse: true,
        mask_input: true
    });

    return true;
}

fn build_passlock_ui(masked_input, status_text) {
    gui_define_style("access_modal", {
        padding: 18,
        spacing: 10,
        corner_radius: 10,
        responsive: true,
        font_size: 20,
        min_font_size: 11,
        max_font_size: 24,
        max_lines: 2,
        auto_fit: true,
        wrap: true,
        ellipsis: true,
        clip_text: true,
        text_align: "center"
    });

    gui_define_style("access_title", {
        font_size: 25,
        min_font_size: 15,
        max_font_size: 28,
        max_lines: 1,
        auto_fit: true,
        wrap: false,
        ellipsis: true,
        clip_text: true,
        text_align: "center"
    });

    gui_define_style("access_help", {
        font_size: 17,
        min_font_size: 11,
        max_font_size: 18,
        max_lines: 3,
        line_height: 1.15,
        auto_fit: true,
        wrap: true,
        ellipsis: true,
        clip_text: true,
        text_align: "center"
    });

    gui_define_style("access_input", {
        font_size: 30,
        min_font_size: 18,
        max_font_size: 32,
        max_lines: 1,
        auto_fit: true,
        wrap: false,
        ellipsis: true,
        clip_text: true,
        text_align: "center"
    });

    gui_define_style("access_status", {
        font_size: 17,
        min_font_size: 11,
        max_font_size: 18,
        max_lines: 1,
        auto_fit: true,
        wrap: false,
        ellipsis: true,
        clip_text: true,
        text_align: "center"
    });

    gui_define_style("access_keypad", {
        font_size: 18,
        min_font_size: 11,
        max_font_size: 20,
        max_lines: 1,
        auto_fit: true,
        wrap: false,
        ellipsis: true,
        clip_text: true,
        text_align: "center"
    });

    gui_begin_modal("hangar_passlock_modal", "ENGINEERING GARAGE ACCESS", "access_modal");
    gui_label("VEK SECURE PASSLOCK", "access_title");
    gui_label("Enter the workshop access PIN to unlock the main garage door.", "access_help");
    gui_password_input("passlock_pin", masked_input, "access_input");
    gui_status_badge("access_status", status_text, "access", "access_status");
    gui_keypad("access_keypad", ["1", "2", "3", "4", "5", "6", "7", "8", "9", "CLEAR", "0", "ENTER"], "access_keypad");
    gui_end_modal();
    return true;
}

fn door_config() {
    return {
        offset_x: -21.0,
        width: 2.4,
        height: 3.0,
        open_angle: 95.0,
        open_speed: 1.65,
        auto_close_delay: 0.75
    };
}

fn access_config() {
    return {
        passlock_offset_x: -18.4,
        passlock_height: 1.45,
        garage_id: "hangar.main_garage",
        passlock_id: "hangar.builder_access",
        keypad_clip: "hangar.use_passlock",
        garage_open_clip: "hangar.garage_open",
        garage_close_clip: "hangar.garage_close"
    };
}
