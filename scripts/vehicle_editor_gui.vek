fn build_editor_ui(mode, search, category, selected_id, parts) {
 gui_define_style("editor_window", {background:rgba(10,17,22,245),foreground:rgba(238,244,245,255),accent:rgba(55,178,190,255),border:rgba(70,110,120,255),padding:10,corner_radius:8,spacing:6});
 gui_define_style("part_card", {background:rgba(21,34,40,245),foreground:rgba(240,245,246,255),accent:rgba(74,196,155,255),padding:8,corner_radius:6,spacing:4});
 gui_begin_window("vehicle_editor", "ENGINEERING PART CATALOG", "editor_window");
 gui_begin_vertical("root");
 let q = gui_search_box("part_search", search);
 gui_begin_horizontal("categories_a");
 gui_button("cat_Structural", "STRUCT");
 gui_button("cat_Movement", "MOVE");
 gui_button("cat_Mechanical", "MECH");
 gui_button("cat_Functional", "FUNC");
 gui_button("cat_Aircraft", "AIR");
 gui_end_horizontal();
 gui_begin_horizontal("categories_b");
 gui_button("cat_Marine", "MARINE");
 gui_button("cat_Experimental", "EXPER");
 gui_button("cat_Favorites", "FAVORITES");
 gui_button("cat_Recent", "RECENT");
 gui_end_horizontal();
 gui_separator();
 gui_begin_scroll("part_scroll");
 gui_begin_grid("part_grid", 2);
 let i = 0;
 while i < len(parts) {
   let p = parts[i];
   let id = "part_" + p.id;
   gui_begin_panel("card_" + p.id, "part_card");
   gui_image_button("preview_" + p.id, p.icon, p.category);
   gui_label(p.display_name);
   gui_label(p.subcategory + " | " + p.mass + " kg");
   if mode == "sandbox" { gui_label("SANDBOX: FREE / unlimited copies"); }
   else { gui_label("$" + p.price + " | Dur " + p.durability + " | L" + p.unlock_level); }
   if p.locked { gui_label("LOCKED: " + p.technology); }
   else { if selected_id == p.id { gui_button(id, "SELECTED"); } else { gui_button(id, "SELECT PART"); } }
   gui_tooltip(id, p.description);
   gui_end_panel();
   i = i + 1;
 }
 gui_end_grid();
 gui_end_scroll();
 gui_separator();
 gui_begin_horizontal("camera_tools");
 gui_button("cam_front", "FRONT");
 gui_button("cam_side", "SIDE");
 gui_button("cam_top", "TOP");
 gui_button("cam_focus", "FOCUS");
 gui_end_horizontal();
 gui_begin_horizontal("build_tools");
 gui_button("toggle_com", "CENTRE OF MASS");
 gui_button("construct_vehicle", "VALIDATE & BUILD");
 gui_end_horizontal();
 gui_end_vertical();
 gui_end_window();
 return q;
}
