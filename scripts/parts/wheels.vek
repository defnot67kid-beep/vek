fn register_parts() {
 part_register({id:"wheel.road",category:"Movement",subcategory:"Wheels",display_name:"Road Wheel",description:"Standard road tyre and wheel.",visual:"wheel",presentation:part_presentation("icon:wheel.road","builtin:wheel.road","builtin:wheel.road",{material:"rubber_alloy",allow_tint:false}),mass:25,price:80,durability:100,unlock_level:1,size:vec3(0.70,1.20,1.20),tags:["wheel","movement","road"],components:[component("Wheel",{radius:0.60,width:0.35,traction:1.0}),component("Durability",{value:100})],attachments:[attachment("hub","wheel_hub",vec3(0,0,0),vec3(1,0,0),["suspension","axle"])]});
