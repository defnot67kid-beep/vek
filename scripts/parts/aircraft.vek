fn register_parts(){
 part_register({id:"wing.medium",category:"Aircraft",subcategory:"Wings",display_name:"Medium Wing Section",description:"Airfoil section for experimental aircraft.",visual:"wing",presentation:part_presentation("icon:wing.medium","builtin:wing.medium","builtin:wing.medium",{material:"aircraft_skin",allow_tint:true}),mass:65,price:260,durability:120,unlock_level:14,technology:"flight_basics",size:vec3(4.0,0.18,1.25),tags:["wing","aircraft","structural"],components:[component("Wing",{area:4.8,lift_coefficient:1.1,drag:0.08})],attachments:[attachment("root","structural",vec3(0,0,0),vec3(1,0,0),["structural"])]});
 part_register({id:"propeller.medium",category:"Aircraft",subcategory:"Propulsion",display_name:"Medium Propeller",description:"Aircraft propeller driven by engine shaft.",visual:"propeller",presentation:part_presentation("icon:propeller.aircraft","builtin:propeller.aircraft","builtin:propeller.aircraft",{material:"propeller_alloy",allow_tint:false}),mass:45,price:340,durability:110,unlock_level:15,technology:"flight_basics",size:vec3(2.4,0.2,0.2),tags:["propeller","aircraft","movement"],components:[component("Propeller",{thrust_factor:1.0,max_rpm:2600})],attachments:[attachment("shaft","mechanical",vec3(0,0,0),vec3(0,0,-1),["mechanical"])]});
 part_register({id:"rotor.helicopter",category:"Aircraft",subcategory:"Rotors",display_name:"Helicopter Rotor",description:"Large lift rotor for rotorcraft experiments.",visual:"rotor",presentation:part_presentation("icon:rotor.helicopter","builtin:rotor.helicopter","builtin:rotor.helicopter",{material:"rotor_composite",allow_tint:false}),mass:80,price:680,durability:130,unlock_level:20,technology:"rotorcraft",size:vec3(5.5,0.15,0.35),tags:["rotor","aircraft","movement"],components:[component("Rotor",{lift:42000,drag:0.12})],attachments:[attachment("shaft","mechanical",vec3(0,0,0),vec3(0,-1,0),["mechanical"])]});
 part_register({id:"engine.jet_small",category:"Aircraft",subcategory:"Jet",display_name:"Small Jet Engine",description:"High-thrust experimental jet engine.",visual:"jet",presentation:part_presentation("icon:jet.small","builtin:jet.small","builtin:jet.small",{material:"jet_alloy",allow_tint:false}),mass:240,price:3500,durability:150,unlock_level:30,technology:"jet_propulsion",size:vec3(1.15,1.15,2.3),tags:["engine","jet","aircraft","powered"],components:[component("Thruster",{thrust:90000,fuel:"jet_fuel",consumption:4.5})],attachments:[attachment("mount","structural",vec3(0,0,0),vec3(0,1,0),["structural"])]});
 return part_count();}
