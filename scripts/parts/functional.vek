fn register_parts(){
 part_register({id:"seat.driver",category:"Functional",subcategory:"Seats",display_name:"Driver Seat",description:"Required driver control seat.",visual:"seat",presentation:part_presentation("icon:seat.bucket","builtin:seat.bucket","builtin:seat.bucket",{material:"fabric_vinyl",allow_tint:false}),mass:20,price:100,durability:100,unlock_level:1,size:vec3(0.8,1.1,0.8),tags:["seat","driver","functional"],components:[component("Seat",{driver:true})],attachments:[attachment("base","structural",vec3(0,-0.55,0),vec3(0,-1,0),["structural"])]});
