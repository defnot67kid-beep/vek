fn register_parts(){
 part_register({id:"marine.hull_block",category:"Marine",subcategory:"Hull",display_name:"Buoyant Hull Block",description:"Sealed hull block for boat experiments.",visual:"hull",presentation:part_presentation("icon:marine.hull","builtin:marine.hull","builtin:marine.hull",{material:"marine_hull",allow_tint:true}),mass:90,price:240,durability:180,unlock_level:10,technology:"marine_basics",size:vec3(1.8,0.8,2.4),tags:["marine","hull","structural"],components:[component("Buoyancy",{volume:2.8,drag:0.5})],attachments:[attachment("top","structural",vec3(0,0.4,0),vec3(0,1,0),["structural","mechanical"])]});
