fn register_parts(){
 part_register({id:"suspension.basic",category:"Mechanical",subcategory:"Suspension",display_name:"Basic Suspension Unit",description:"Spring/damper wheel suspension.",visual:"suspension",presentation:part_presentation("icon:suspension.basic","builtin:suspension.basic","builtin:suspension.basic",{material:"spring_steel",allow_tint:false}),mass:32,price:120,durability:120,unlock_level:3,size:vec3(0.45,0.85,0.45),tags:["suspension","mechanical"],components:[component("Suspension",{travel:0.35,spring:18000,damping:1900})],attachments:[attachment("frame","structural",vec3(0,0.42,0),vec3(0,1,0),["structural"]),attachment("hub","suspension",vec3(0,-0.42,0),vec3(0,-1,0),["wheel_hub"])]});
