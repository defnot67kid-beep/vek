fn part_cost(mode, base_cost) { return mode_part_cost(mode, base_cost); }
fn part_unlocked(mode, level, required_level, sandbox_only) { return editor_part_unlocked(mode, level, required_level, sandbox_only); }
fn max_parts(mode) { return editor_max_parts(mode, 300, 800); }
fn grid_steps() { return [1.0, 0.5, 0.25, 0.10, 0.05]; }
fn placement_valid(mode, x, z, part_count) {
 if !editor_inside_radius(x, z, 42) { return false; }
 return part_count < max_parts(mode);
}
fn placement_status(intersects, has_compatible_node, distance_to_support) {
 if intersects { return "invalid"; }
 if !has_compatible_node && distance_to_support > 2.5 { return "warning"; }
 return "allowed";
}
fn attachment_compatible(a, b) {
 if a == b { return true; }
 if a == "structural" && b == "mechanical" { return true; }
 if a == "mechanical" && b == "structural" { return true; }
 if a == "wheel_hub" && b == "suspension" { return true; }
 if a == "suspension" && b == "wheel_hub" { return true; }
 return false;
}
fn build_valid(mode, structural, engines, seats, wheels, movement, money, cost) {
 if structural < 1 { return false; }
 if engines < 1 { return false; }
 if seats < 1 { return false; }
 if wheels < 3 && movement < 1 { return false; }
 if mode == "survival" && money < cost { return false; }
 return true;
}
fn build_message(mode, structural, engines, seats, wheels, movement, money, cost) {
 if structural < 1 { return "Add a structural frame or chassis."; }
 if seats < 1 { return "Add a driver seat."; }
 if engines < 1 { return "Add an engine, motor, or powered propulsion component."; }
 if wheels < 3 && movement < 1 { return "Add wheels, tracks, rotor, propeller or thrust movement."; }
 if mode == "survival" && money < cost { return "Not enough money to construct this design."; }
 return "Design validated. Ready to construct.";
}
fn power_warning(mass, power) {
 let ratio = editor_power_to_weight(mass, power);
 if ratio < 12 { return "WARNING: VERY LOW POWER-TO-WEIGHT"; }
 if ratio < 20 { return "WARNING: LOW POWER-TO-WEIGHT"; }
 return "";
}
fn upgrade_cost(mode, base_cost) { return mode_part_cost(mode, base_cost); }
fn infinite_fuel(mode) { return mode_is_sandbox(mode); }
fn free_placement_allowed(mode) { return mode == "sandbox"; }
fn symmetry_allowed(mode) { return true; }
