# VEK 2.0 hardened secure authority + presentation policy.
# Native networking authenticates connections, establishes encrypted sessions,
# and transports messages. VEK defines deterministic server-side validation.

fn action(id, rate, burst, payload, capability, allow_client) {
    return authority_action_register({
        id: id,
        server_authoritative: true,
        allow_client_request: allow_client,
        require_sequence: true,
        replay_protected: true,
        require_authenticated_session: true,
        max_requests_per_second: rate,
        burst: burst,
        max_payload_bytes: payload,
        max_payload_depth: 8,
        max_payload_items: 128,
        max_string_bytes: 1024,
        min_nonce_bytes: 16,
        max_nonce_bytes: 96,
        required_capability: capability
    });
}

fn field(name, type, owner_only) {
    return {name:name, type:type, server_owned:true, owner_only:owner_only};
}

fn setup_security_authority() {
    # Economy/inventory: clients request purchases; rewards and raw inventory
    # mutation are server-only commits.
    action("economy.purchase", 6, 10, 2048, "economy.purchase", true);
    action("economy.reward", 2, 4, 1024, "server.reward", false);
    action("progression.award_xp", 3, 5, 1024, "server.progression", false);
    action("inventory.add", 6, 10, 4096, "inventory.modify", false);
    action("inventory.remove", 6, 10, 4096, "inventory.modify", false);

    # Jobs/missions. Completion may be requested by a client, but only the
    # server validates world facts and performs the authoritative commit.
    action("job.accept", 3, 5, 2048, "jobs.use", true);
    action("job.complete", 2, 4, 4096, "jobs.complete", true);

    # Player state. Damage/heal are server-owned; reset is an authenticated request.
    action("player.damage", 30, 40, 2048, "server.damage", false);
    action("player.heal", 8, 12, 2048, "server.heal", false);
    action("player.reset", 2, 4, 1024, "player.reset", true);

    # Vehicle/editor requests. Server re-validates parts, costs, limits and state.
    action("vehicle.finalize", 2, 4, 16384, "vehicle.build", true);
    action("vehicle.spawn", 2, 4, 8192, "vehicle.spawn", true);
    action("vehicle.repair", 5, 8, 4096, "vehicle.repair", true);
    action("vehicle.upgrade", 3, 6, 4096, "vehicle.upgrade", true);

    replication_schema_register({
        id:"replication.player",
        max_hz:30,
        reliable:false,
        fields:[
            field("x","number",false), field("y","number",false), field("z","number",false),
            field("yaw","number",false), field("health","number",false), field("stamina","number",true),
            field("ragdoll","bool",false)
        ]
    });
    replication_schema_register({
        id:"replication.economy",
        max_hz:4,
        reliable:true,
        fields:[field("money","int",true),field("xp","int",true),field("reputation","int",true)]
    });
    replication_schema_register({
        id:"replication.vehicle",
        max_hz:30,
        reliable:false,
        fields:[field("position","vec3",false),field("heading","number",false),field("speed","number",false),field("fuel","number",false),field("condition","number",false)]
    });
    return true;
}

fn game_shell_policy() {
    return {
        show_help_overlay: false,
        show_map_instruction_bar: false,
        performance_toggle_key: "F",
        performance_default_visible: false,
        performance_show_fps: true,
        performance_show_frame_ms: true,
        performance_show_vek_mode: true,
        performance_show_authority: true,
        camera_floor_clearance: 0.35,
        camera_target_floor_clearance: 0.05,
        standalone_authority_role: "standalone",
        multiplayer_default_role: "dedicated_server",
        server_authoritative_economy: true,
        server_authoritative_inventory: true,
        server_authoritative_jobs: true,
        server_authoritative_health: true,
        server_authoritative_vehicles: true,
        require_authenticated_sessions: true,
        deterministic_validation_only: true,
        reject_unknown_actions: true
    };
}
