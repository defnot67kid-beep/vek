// VEK 1.2 main menu. The host renders the renderer-neutral GUI commands.
fn main_menu() {
    gui_begin_window("main", "VEK VEHICLE ENGINEERING", 0, 0, 100, 100);
    gui_label("Choose your engineering mode");

    if gui_button("survival", "SURVIVAL") {
        gui_end_window();
        return "survival";
    }

    if gui_button("sandbox", "SANDBOX") {
        gui_end_window();
        return "sandbox";
    }

    gui_end_window();
    return "";
}
